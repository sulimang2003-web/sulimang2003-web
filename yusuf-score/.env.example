# ───────────────────────── YUSUF SCORE — environment ─────────────────────────
# Copy to .env.local and fill in. NEVER commit real values.

# Public site URL (used for canonical links, sitemap, WhatsApp/UTM links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin session (required in every mode) ──
# Long random string: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── DEMO MODE (no Supabase) ──
# Used only when Supabase variables below are empty. Data lives in .data/db.json
ADMIN_EMAIL=owner@yusufscore.demo
ADMIN_PASSWORD=ChangeMe-2026!

# ── PRODUCTION MODE (Supabase) ──
# When both are set, the store reads/writes Supabase instead of the demo file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Analytics (leave empty until consent banner + KVKK review are done) ──
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# ── Payments (not active until a licensed provider account exists) ──
# PAYMENT_PROVIDER=none | iyzico | paytr
PAYMENT_PROVIDER=none
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
